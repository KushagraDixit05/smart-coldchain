# Postgres (matches docker-compose.yml at repo root for local dev)
DATABASE_URL=postgres://bkt:bkt_dev_password@127.0.0.1:5433/bkt

# JWT signing secret for admin auth — set to a long random string
JWT_SECRET=

# Blockchain
# Local dev: http://127.0.0.1:8545 (npx hardhat node, run from contracts/)
# Phase 4: your Sepolia RPC URL
RPC_URL=http://127.0.0.1:8545

# Address the ShipmentRegistry contract was deployed to
CONTRACT_ADDRESS=

# Private key for the ADMIN_ROLE account (creates shipments, marks delivered)
ADMIN_PRIVATE_KEY=

# Private key for the DEVICE_ROLE account (records breaches) — this is the
# backend acting on behalf of the device/simulator, not the device itself
DEVICE_PRIVATE_KEY=

PORT=4000
